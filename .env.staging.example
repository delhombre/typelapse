# Staging (https://staging.typelapse.com). Names only, no values: this file is a
# checklist for the GitHub Environment `staging`. Never commit a real
# `.env.staging` (it is git-ignored). See infra/kubernetes/README.md.

# ---- GitHub Environment SECRETS (Settings > Environments > staging > Secrets) ----

# Base64 of the kubeconfig for the typelapse deployer identity (infra-infomaniak): base64 -i kubeconfig
KUBECONFIG_INFOMANIAK=
# Neon console > Connection details > pooled connection string (host contains -pooler).
DATABASE_URL=
# Optional. Neon console > Connection details, the direct (non-pooled) string. The release Job migrates through it; without it, through DATABASE_URL.
DATABASE_DIRECT_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Cloudflare R2 > Manage API tokens > Object Read & Write, scoped to the staging bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# sandbox.polar.sh > Settings > Developers > Organization access token (sandbox, never production).
POLAR_ACCESS_TOKEN=
# sandbox.polar.sh > Settings > Webhooks: endpoint https://staging.typelapse.com/api/billing/webhook, copy its signing secret.
POLAR_WEBHOOK_SECRET=
# Optional. GitHub fine-grained token, public repositories, no permission; raises the render-by-URL rate limit.
TYPELAPSE_GITHUB_TOKEN=
# Required while the repository is private (the GHCR image is private too). Classic personal access token with only read:packages, created by the account that owns the repository; the cluster pulls the image with it.
GHCR_PULL_TOKEN=

# ---- GitHub Environment VARIABLES (same page, Variables; not secret) ----

# Cloudflare dashboard > R2 > Overview, Account ID.
R2_ACCOUNT_ID=
# Name of the staging R2 bucket (private, CORS limited to https://staging.typelapse.com, GET/PUT/HEAD and Content-Type).
R2_BUCKET=
# sandbox.polar.sh > Products: the monthly Creator product ID. `pnpm billing:sandbox-products` can create it.
POLAR_CREATOR_MONTHLY_PRODUCT_ID=
# Optional, same place: the annual Creator product ID. Leave empty without one.
POLAR_CREATOR_ANNUAL_PRODUCT_ID=
# Memory request of the render worker (the limit is fixed at 2Gi in render-worker.yaml, from a measured 1.72 to 1.81 GB peak). Waits for a decision; the namespace quota caps it at 736Mi.
RENDER_MEMORY_REQUEST=

# Optional. Set to true once the GHCR package is public: the workflow then stops requiring GHCR_PULL_TOKEN.
GHCR_PACKAGE_PUBLIC=

# ---- Fixed in infra/kubernetes/staging/configmap.yaml, nothing to set ----
# TYPELAPSE_DEPLOYMENT_MODE=hosted, POLAR_ENVIRONMENT=sandbox, TYPELAPSE_APP_URL,
# CORS_ORIGIN and BETTER_AUTH_URL (from the workflow's APP_HOST), PORT,
# TYPELAPSE_COMPILER_VERSION (the commit SHA).
