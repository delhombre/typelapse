# Typelapse has two explicit deployment profiles.
#
# local  — account-free studio plus the synchronous self-hosted render endpoint.
# hosted — private projects, media, billing and queued rendering. Hosted mode
#          never exposes the anonymous synchronous render endpoint.
TYPELAPSE_DEPLOYMENT_MODE=local

# Public URLs. Keep these on HTTPS outside local development.
# The app's origin must route /v/* to the API as it routes /api/*: public render
# pages are server-rendered HTML with Open Graph tags, written on TYPELAPSE_APP_URL.
TYPELAPSE_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001

# Optional. A directory holding the Vite build (`pnpm build` writes dist/): the API
# then serves the app itself, so one origin answers /, /app, /api/*, /v/* and /health.
# Unset (the default) the API serves no pages. The container image sets it to /app/dist.
TYPELAPSE_STATIC_ROOT=

# Hosted persistence and sessions. Any standard PostgreSQL connection URL works;
# use the provider's pooled URL when deploying to a serverless runtime. A partial
# auth configuration fails closed.
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The browser distinguishes a deliberately local/offline build from a hosted
# build whose account service is unavailable.
VITE_TYPELAPSE_DEPLOYMENT_MODE=local
VITE_TYPELAPSE_AUTH_ENABLED=false
# Optional. Leave empty for the Better Auth client's same-origin default.
VITE_BETTER_AUTH_URL=

# Private Cloudflare R2 bucket. Objects must not be publicly addressable.
R2_ACCOUNT_ID=
# Optional override; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Direct browser PUT/GET requires bucket CORS for TYPELAPSE_APP_URL. Allow only
# the exact production origin, GET/PUT/HEAD and Content-Type; do not use a
# wildcard origin with credentials.

# Creator plan, sold through Polar (merchant of record: Polar collects and
# remits VAT and sales tax). Product IDs and redirect destinations are
# server-owned; the browser never submits one. The annual product is optional;
# `/api/billing/catalog` only exposes configured, active recurring products
# returned by Polar. Point Polar's webhook endpoint at
# `<API origin>/api/billing/webhook` and copy its signing secret below.
# POLAR_ENVIRONMENT is `production` (the default) or `sandbox`, which runs
# every call against sandbox.polar.sh with the sandbox organisation's token.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_CREATOR_MONTHLY_PRODUCT_ID=
POLAR_CREATOR_ANNUAL_PRODUCT_ID=
POLAR_ENVIRONMENT=production
# Optional, honoured only with POLAR_ENVIRONMENT=sandbox: a self-hosted Polar or a test double.
POLAR_API_URL=

# Sandbox only, for the hosted billing journey (tests/e2e/hosted/billing.spec.ts)
# and `pnpm billing:sandbox-products`. A sandbox organisation's token and webhook
# secret from sandbox.polar.sh; the journey skips without the token.
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_SANDBOX_WEBHOOK_SECRET=

# Bump whenever the canonical renderer changes. It participates in hosted job
# idempotency, so an old render is never mistaken for output from a new engine.
TYPELAPSE_COMPILER_VERSION=dev

# Hosted render worker. Run separately with `pnpm worker:render`; the API only
# enqueues canonical revisions and never performs hosted work in-request.
TYPELAPSE_RENDER_WORKER_ID=
TYPELAPSE_RENDER_LEASE_MS=120000
TYPELAPSE_RENDER_HEARTBEAT_MS=15000
TYPELAPSE_RENDER_MAX_ATTEMPTS=3
TYPELAPSE_RENDER_RETRY_BASE_MS=5000
TYPELAPSE_RENDER_RETRY_MAX_MS=60000
TYPELAPSE_RENDER_IDLE_MIN_MS=250
TYPELAPSE_RENDER_IDLE_MAX_MS=5000
TYPELAPSE_RENDER_FAILURE_MS=5000
TYPELAPSE_RENDER_TIMEOUT_MS=900000
# Optional absolute or process-relative parent for per-job mkdtemp workspaces.
TYPELAPSE_RENDER_TEMP_ROOT=
# Optional, 1 to 16: frames Chromium renders at once. Unset leaves Remotion's own
# choice, half the cores it sees, which in a container is the node's, not the
# container's limit. The container image sets 1.
TYPELAPSE_RENDER_CONCURRENCY=

# Drain mode, read by both workers (render and object deletion). true: the worker
# exits with code 0 the first time it finds nothing to claim, instead of sleeping
# and polling again, so it can run as a scheduled job. false or unset: the
# long-running loop. Any other value stops the worker at startup, an empty one
# too, on purpose: a typo must not silently turn a scheduled job into a loop.
TYPELAPSE_WORKER_EXIT_WHEN_IDLE=false

# Optional. Render by URL reads GitHub with no credential (60 requests an hour for
# this server's address). A token raises that to its own limit. Create a
# fine-grained personal access token with repository access "Public repositories"
# and no permissions; private repositories are refused whatever the token sees.
TYPELAPSE_GITHUB_TOKEN=

# Before starting a hosted deployment, run `pnpm hosted:check`. It exits non-zero
# and lists every unavailable capability when this configuration is incomplete.
