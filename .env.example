# Typelapse has two explicit deployment profiles.
#
# local  — account-free studio plus the synchronous self-hosted render endpoint.
# hosted — private projects, media, billing and queued rendering. Hosted mode
#          never exposes the anonymous synchronous render endpoint.
TYPELAPSE_DEPLOYMENT_MODE=local

# Public URLs. Keep these on HTTPS outside local development.
TYPELAPSE_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001

# Hosted persistence and sessions. Any standard PostgreSQL connection URL works;
# use the provider's pooled URL when deploying to a serverless runtime. A partial
# auth configuration fails closed.
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The browser distinguishes a deliberately local/offline build from a hosted
# build whose account service is unavailable.
VITE_TYPELAPSE_DEPLOYMENT_MODE=local
VITE_TYPELAPSE_AUTH_ENABLED=false
# Optional. Leave empty for the Better Auth client's same-origin default.
VITE_BETTER_AUTH_URL=

# Private Cloudflare R2 bucket. Objects must not be publicly addressable.
R2_ACCOUNT_ID=
# Optional override; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Direct browser PUT/GET requires bucket CORS for TYPELAPSE_APP_URL. Allow only
# the exact production origin, GET/PUT/HEAD and Content-Type; do not use a
# wildcard origin with credentials.

# Stripe Creator plan. Price IDs and redirect destinations are server-owned.
# The annual price is optional; `/api/billing/catalog` only exposes configured,
# active recurring prices returned by Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_MONTHLY_PRICE_ID=
STRIPE_CREATOR_ANNUAL_PRICE_ID=

# Bump whenever the canonical renderer changes. It participates in hosted job
# idempotency, so an old render is never mistaken for output from a new engine.
TYPELAPSE_COMPILER_VERSION=dev

# Hosted render worker. Run separately with `pnpm worker:render`; the API only
# enqueues canonical revisions and never performs hosted work in-request.
TYPELAPSE_RENDER_WORKER_ID=
TYPELAPSE_RENDER_LEASE_MS=120000
TYPELAPSE_RENDER_HEARTBEAT_MS=15000
TYPELAPSE_RENDER_MAX_ATTEMPTS=3
TYPELAPSE_RENDER_RETRY_BASE_MS=5000
TYPELAPSE_RENDER_RETRY_MAX_MS=60000
TYPELAPSE_RENDER_IDLE_MIN_MS=250
TYPELAPSE_RENDER_IDLE_MAX_MS=5000
TYPELAPSE_RENDER_FAILURE_MS=5000
TYPELAPSE_RENDER_TIMEOUT_MS=900000
# Optional absolute or process-relative parent for per-job mkdtemp workspaces.
TYPELAPSE_RENDER_TEMP_ROOT=

# Before starting a hosted deployment, run `pnpm hosted:check`. It exits non-zero
# and lists every unavailable capability when this configuration is incomplete.
