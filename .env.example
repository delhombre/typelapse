# Typelapse runs fully without any of these: the studio renders on your own
# machine and never needs an account. They are only required to run the hosted
# side (accounts, and later billing and hosted rendering).

# Neon Postgres connection string. Absent means no accounts, and hosted
# rendering stays closed. The local render endpoint is unaffected.
DATABASE_URL=

# Signing secret for sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the auth handler is served from, e.g. http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001

# Origin allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173
