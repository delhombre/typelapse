{
	"name": "typelapse",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A scene-first multimedia motion studio",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
		"worker:object-deletion": "tsx --env-file-if-exists=.env server/workers/object-deletion.entrypoint.ts",
		"worker:render": "tsx --env-file-if-exists=.env server/workers/hosted-render.entrypoint.ts",
		"build": "tsc && tsc -p server/tsconfig.json && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check-types": "tsc --noEmit",
		"typecheck:server": "tsc -p server/tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"hosted:check": "tsx --env-file-if-exists=.env server/config/hosted-check.entrypoint.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1121.0",
		"@aws-sdk/s3-request-presigner": "^3.1121.0",
		"@hono/node-server": "^2.0.10",
		"@monaco-editor/react": "^4.7.0",
		"@remotion/bundler": "^4.0.505",
		"@remotion/cli": "^4.0.505",
		"@remotion/renderer": "^4.0.505",
		"better-auth": "^1.6.26",
		"drizzle-orm": "^0.45.2",
		"file-type": "^21.3.4",
		"gifenc": "1.0.3",
		"hono": "^4.12.34",
		"idb": "^8.0.3",
		"mediabunny": "1.53.0",
		"modern-screenshot": "^4.6.8",
		"motion": "^12.0.0",
		"pg": "^8.23.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.2",
		"reicon-react": "^1.2.0",
		"remotion": "^4.0.505",
		"shiki": "^3.0.0",
		"shiki-magic-move": "^1.3.0",
		"simple-icons": "^16.27.0",
		"stripe": "^22.6.0",
		"tsx": "^4.21.0",
		"vaul": "^1.1.2",
		"web-haptics": "^0.0.6",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"drizzle-kit": "^0.31.10",
		"fake-indexeddb": "^6.2.5",
		"fontkit": "^2.0.4",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.8.0",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	}
}
