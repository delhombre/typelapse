{
	"name": "typelapse",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Open-source animated code snippet videos",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx watch server/index.ts",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.11",
		"@monaco-editor/react": "^4.7.0",
		"@remotion/bundler": "^4.0.434",
		"@remotion/cli": "^4.0.434",
		"@remotion/renderer": "^4.0.434",
		"hono": "^4.12.12",
		"modern-screenshot": "^4.6.8",
		"motion": "^12.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"remotion": "^4.0.434",
		"shiki": "^3.0.0",
		"shiki-magic-move": "^1.3.0",
		"tsx": "^4.21.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.8.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
