{
	"name": "typelapse",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Open-source animated code snippet videos",
	"license": "AGPL-3.0-only",
	"bin": {
		"typelapse": "cli/bin.mjs"
	},
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
		"worker:object-deletion": "tsx --env-file-if-exists=.env server/workers/object-deletion.entrypoint.ts",
		"worker:render": "tsx --env-file-if-exists=.env server/workers/hosted-render.entrypoint.ts",
		"build": "tsc && tsc -p server/tsconfig.json && vite build",
		"preview": "vite preview",
		"billing:sandbox-products": "tsx --env-file-if-exists=.env scripts/polar-sandbox-products.ts",
		"demo:render": "tsx scripts/render-demo.mjs",
		"typelapse": "node cli/bin.mjs",
		"render:smoke": "tsx scripts/render-smoke.ts",
		"sharpness:render": "tsx scripts/render-sharpness.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"e2e:smoke": "playwright test --grep @smoke",
		"e2e:hosted": "E2E_PROFILE=hosted playwright test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check-types": "tsc --noEmit",
		"figures:validate": "node scripts/figures/validate.mjs",
		"typecheck:server": "tsc -p server/tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"hosted:check": "tsx --env-file-if-exists=.env server/config/hosted-check.entrypoint.ts",
		"test:e2e": "e2e run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1121.0",
		"@aws-sdk/s3-request-presigner": "^3.1121.0",
		"@hono/node-server": "^2.0.10",
		"@monaco-editor/react": "^4.7.0",
		"@neondatabase/serverless": "^1.1.0",
		"@polar-sh/sdk": "^1.0.2",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@remotion/bundler": "^4.0.505",
		"@remotion/cli": "^4.0.505",
		"@remotion/renderer": "^4.0.505",
		"better-auth": "^1.6.26",
		"drizzle-orm": "^0.45.2",
		"file-type": "^21.3.4",
		"gifenc": "1.0.3",
		"hono": "^4.13.5",
		"idb": "^8.0.3",
		"mediabunny": "1.53.0",
		"monaco-editor": "0.55.1",
		"motion": "^12.0.0",
		"nodemailer": "^10.0.15",
		"pg": "^8.23.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.2",
		"reicon-react": "^1.2.0",
		"remotion": "^4.0.505",
		"shiki": "^3.0.0",
		"shiki-magic-move": "^1.3.0",
		"simple-icons": "^16.27.0",
		"tsx": "^4.21.0",
		"vaul": "^1.1.2",
		"web-haptics": "^0.0.6",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@ai-sdk/google": "^4.0.87",
		"@biomejs/biome": "^1.9.0",
		"@e2e-dev/web": "^0.13.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"ai": "^7.0.0",
		"drizzle-kit": "^0.31.10",
		"e2e": "^0.18.0",
		"fake-indexeddb": "^6.2.5",
		"fontkit": "^2.0.4",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.8.0",
		"vite": "^6.4.5",
		"vitest": "^4.1.11",
		"zod": "^4.1.8"
	}
}
