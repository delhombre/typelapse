{
	"name": "typelapse",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Open-source animated code snippet videos",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx watch server/index.ts",
		"build": "tsc && tsc -p server/tsconfig.json && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check-types": "tsc --noEmit",
		"typecheck:server": "tsc -p server/tsconfig.json"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.10",
		"@monaco-editor/react": "^4.7.0",
		"@remotion/bundler": "^4.0.434",
		"@remotion/cli": "^4.0.434",
		"@remotion/renderer": "^4.0.434",
		"hono": "^4.12.34",
		"modern-screenshot": "^4.6.8",
		"motion": "^12.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.2",
		"remotion": "^4.0.434",
		"shiki": "^3.0.0",
		"shiki-magic-move": "^1.3.0",
		"simple-icons": "^16.27.0",
		"tsx": "^4.21.0",
		"vaul": "^1.1.2",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"fontkit": "^2.0.4",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.8.0",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	}
}
